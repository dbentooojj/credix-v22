# Cole o conteúdo deste arquivo no secret PROD_ENV_FILE do environment production.
# APP_BASE_URL deve ser https://www.credix.app.br e CADDY_EMAIL é obrigatório.
# ADMIN_PASSWORD precisa ter no mínimo 12 caracteres; JWT_SECRET, no mínimo 32.
# POSTGRES_PASSWORD deve ser uma senha forte (o preflight exige ao menos 16 caracteres).
PORT=4000
APP_BASE_URL=https://www.credix.app.br
CADDY_EMAIL=admin@credix.app.br

POSTGRES_USER=credix
POSTGRES_PASSWORD=EXEMPLO_TROQUE_POR_SENHA_FORTE_2026
POSTGRES_DB=credix

JWT_SECRET=EXEMPLO_TROQUE_POR_UM_SEGREDO_ALEATORIO_COM_32_OU_MAIS_CARACTERES
JWT_EXPIRES_IN=7d
SESSION_IDLE_MINUTES=30
COOKIE_NAME=credix_token
COOKIE_SECURE=true

ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@seu-dominio.com
ADMIN_PASSWORD=ExemploAdminSeguro2026
