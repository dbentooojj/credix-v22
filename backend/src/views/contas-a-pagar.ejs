        const payableViewSubtitle = document.getElementById('payableViewSubtitle');
        const payableViewDescription = document.getElementById('payableViewDescription');
        const payableViewStatusBadge = document.getElementById('payableViewStatusBadge');
        const payableViewCategory = document.getElementById('payableViewCategory');
        const payableViewAmount = document.getElementById('payableViewAmount');
        const payableViewDate = document.getElementById('payableViewDate');
        const payableViewStatusText = document.getElementById('payableViewStatusText');
        const payableViewObservation = document.getElementById('payableViewObservation');
        const closePayableViewModalBtn = document.getElementById('closePayableViewModalBtn');
        const closePayableViewFooterBtn = document.getElementById('closePayableViewFooterBtn');
        const openPayableEditFromViewBtn = document.getElementById('openPayableEditFromViewBtn');
        const payableDeleteModal = document.getElementById('payableDeleteModal');
        const payableDeleteTitle = document.getElementById('payableDeleteTitle');
        const payableDeleteMessage = document.getElementById('payableDeleteMessage');
        const closePayableDeleteModalBtn = document.getElementById('closePayableDeleteModalBtn');
        const cancelPayableDeleteBtn = document.getElementById('cancelPayableDeleteBtn');
        const confirmPayableDeleteBtn = document.getElementById('confirmPayableDeleteBtn');

        const SYSTEM_TRANSACTION_CATEGORIES = new Set(Array.isArray(pageText.systemCategories) ? pageText.systemCategories : []);
        const STATUS_FILTERS = [
            { key: 'all', label: 'Todas' },
            { key: 'pending', label: 'Pendentes' },
            { key: 'paid', label: pageText.statusFilterPaidLabel || 'Pagas' },
            { key: 'overdue', label: 'Vencidas' },
            { key: 'due-today', label: 'Vencendo hoje' },
        ];

        const state = {
            items: [],
            search: '',
            statusFilter: 'all',
            monthCursor: startOfMonth(new Date()),
            page: 1,
            pageSize: 15,
            loading: false,
            saving: false,
            bulkCompleting: false,
            deleting: false,
            editingId: null,
            viewingId: null,
            deletingId: null,
            selectedIds: new Set(),
            filteredSelectableIds: [],
            visibleSelectableIds: [],
            openMenuId: null,
        };

        function startOfDay(date) {
            const next = new Date(date);
            next.setHours(0, 0, 0, 0);
            return next;
        }

        function startOfMonth(date) {
            return new Date(date.getFullYear(), date.getMonth(), 1);
        }

        function parseDateOnly(value) {
            if (typeof value !== 'string') return new Date(NaN);
            const [year, month, day] = value.split('-').map(Number);
            return new Date(year, (month || 1) - 1, day || 1);
        }

        function toDateInputValue(date) {
            if (!(date instanceof Date) || Number.isNaN(date.getTime())) return '';
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        function addMonths(date, diff) {
            return new Date(date.getFullYear(), date.getMonth() + diff, 1);
        }

        function sameMonth(date, monthCursor) {
            return date.getFullYear() === monthCursor.getFullYear() && date.getMonth() === monthCursor.getMonth();
        }

        function formatCurrency(value) {
            return new Intl.NumberFormat('pt-BR', {
                style: 'currency',
                currency: 'BRL',
                minimumFractionDigits: 2,
                maximumFractionDigits: 2,
            }).format(Number(value) || 0);
        }

        function formatAmountPlain(value) {
            return new Intl.NumberFormat('pt-BR', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2,
            }).format(Number(value) || 0);
        }

        function formatDate(value) {
            const date = value instanceof Date ? value : parseDateOnly(value);
            if (Number.isNaN(date.getTime())) return '--';
            return new Intl.DateTimeFormat('pt-BR', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric',
            }).format(date);
        }

        function formatMonthLabel(date) {
            return new Intl.DateTimeFormat('pt-BR', { month: 'long' }).format(date).replace(/^\p{L}/u, (char) => char.toUpperCase());
        }

        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function notify(message, type = 'success') {
            if (typeof showMessage === 'function') {
                showMessage(message, type);
                return;
            }
            window.alert(message);
        }

        function showError(message) {
            payablesError.textContent = message;
            payablesError.classList.remove('hidden');
        }

        function hideError() {
            payablesError.textContent = '';
            payablesError.classList.add('hidden');
        }

        function setScreenLoading(loading) {
            state.loading = loading;
            payablesRoot.classList.toggle('screen-loading', loading);
        }

        function getEntryTypeValue() {
            if (!(payableEntryTypeInput instanceof HTMLSelectElement)) return 'single';
            if (payableEntryTypeInput.value === 'installments') return 'installments';
            if (payableEntryTypeInput.value === 'recurring_monthly') return 'recurring_monthly';
            return 'single';
        }

        function getInstallmentAmountModeValue() {
            if (!(payableInstallmentAmountModeInput instanceof HTMLSelectElement)) return 'total';
            return payableInstallmentAmountModeInput.value === 'per_installment' ? 'per_installment' : 'total';
        }

        function syncInstallmentModeUi() {
            const isEditMode = Boolean(state.editingId);
            const entryType = getEntryTypeValue();
            const isInstallmentMode = !isEditMode && entryType === 'installments';
            const isRecurringMode = !isEditMode && entryType === 'recurring_monthly';

            if (payableEntryTypeInput instanceof HTMLSelectElement) {
                payableEntryTypeInput.disabled = isEditMode || state.saving;
            }
            if (payableInstallmentFields instanceof HTMLElement) {
                payableInstallmentFields.classList.toggle('hidden', !isInstallmentMode);
            }
            if (payableRecurringFields instanceof HTMLElement) {
                payableRecurringFields.classList.toggle('hidden', !isRecurringMode);
            }
            if (payableInstallmentCountInput instanceof HTMLInputElement) {
                payableInstallmentCountInput.disabled = !isInstallmentMode || state.saving;
            }
            if (payableInstallmentAmountModeInput instanceof HTMLSelectElement) {
                payableInstallmentAmountModeInput.disabled = !isInstallmentMode || state.saving;
            }
            if (payableRecurringMonthsInput instanceof HTMLInputElement) {
                payableRecurringMonthsInput.disabled = !isRecurringMode || state.saving;
            }
            if (payableAmountLabel instanceof HTMLElement) {
                if (isInstallmentMode) {
                    payableAmountLabel.textContent = getInstallmentAmountModeValue() === 'per_installment'
                        ? 'Valor por parcela (R$)'
                        : 'Valor total (R$)';
                } else if (isRecurringMode) {
                    payableAmountLabel.textContent = 'Valor mensal (R$)';
                } else {
                    payableAmountLabel.textContent = 'Valor (R$)';
                }
            }
        }

        function setSaving(loading) {
            state.saving = loading;
            savePayableBtn.disabled = loading;
            const entryType = !state.editingId ? getEntryTypeValue() : 'single';
            savePayableBtn.textContent = loading
                ? (entryType === 'installments'
                    ? 'Criando parcelas...'
                    : entryType === 'recurring_monthly'
                        ? 'Gerando recorrencia...'
                        : 'Salvando...')
                : (state.editingId ? (pageText.modalSaveEditLabel || 'Salvar alteracoes') : (pageText.modalSaveNewLabel || 'Salvar conta'));
            syncInstallmentModeUi();
        }

        function getCompleteActionLabel() {
            return pageText.actionCompleteLabel || (pageText.itemType === 'income' ? 'Receber' : 'Pagar');
        }

        function setBulkCompleting(loading) {
            state.bulkCompleting = loading;
            if (!(bulkCompleteBtn instanceof HTMLButtonElement)) return;
            const selectedCount = state.selectedIds.size;
            const baseLabel = `${getCompleteActionLabel()} selecionadas`;
            bulkCompleteBtn.disabled = loading || selectedCount === 0;
            bulkCompleteBtn.textContent = loading ? 'Processando...' : baseLabel;
        }

        function isSelectableStatus(displayStatus) {
            return displayStatus.group !== 'paid';
        }

        function pruneSelectionByFilteredItems() {
            const filteredSet = new Set(state.filteredSelectableIds);
            state.selectedIds.forEach((id) => {
                if (!filteredSet.has(id)) state.selectedIds.delete(id);
            });
        }

        function renderBulkSelectionUi() {
            const filteredIdsSet = new Set(state.filteredSelectableIds);
            const selectedFilteredIds = [...state.selectedIds].filter((id) => filteredIdsSet.has(id));
            const selectedItems = state.items.filter((item) => selectedFilteredIds.includes(item.id));
            const selectedAmount = selectedItems.reduce((acc, item) => acc + (Number(item.amount) || 0), 0);
            const selectedCount = selectedItems.length;

            if (selectedCount === 0) {
                bulkSelectionInfo.textContent = 'Nenhuma conta selecionada.';
            } else if (selectedCount === 1) {
                bulkSelectionInfo.textContent = `1 conta selecionada • ${formatCurrency(selectedAmount)}`;
            } else {
                bulkSelectionInfo.textContent = `${selectedCount} contas selecionadas • ${formatCurrency(selectedAmount)}`;
            }

            const visibleIds = state.visibleSelectableIds;
            if (payablesSelectAllCheckbox instanceof HTMLInputElement) {
                const visibleSelectedCount = visibleIds.filter((id) => state.selectedIds.has(id)).length;
                payablesSelectAllCheckbox.checked = visibleIds.length > 0 && visibleSelectedCount === visibleIds.length;
                payablesSelectAllCheckbox.indeterminate = visibleSelectedCount > 0 && visibleSelectedCount < visibleIds.length;
                payablesSelectAllCheckbox.disabled = visibleIds.length === 0 || state.bulkCompleting;
            }

            setBulkCompleting(state.bulkCompleting);
        }

        function normalizeTransaction(row) {
            return {
                id: String(row?.id || ''),
                type: row?.type === 'expense' ? 'expense' : 'income',
                amount: Number(row?.amount || 0),
                category: String(row?.category || '').trim(),
                date: String(row?.date || ''),
                description: String(row?.description || '').trim(),
                status: row?.status === 'completed' || row?.status === 'scheduled' ? row.status : 'pending',
            };
        }

        function matchesPageTransaction(item) {
            return item.type === (pageText.itemType || 'expense') && !SYSTEM_TRANSACTION_CATEGORIES.has(item.category);
        }

        function getDisplayStatus(item) {
            const dueDate = startOfDay(parseDateOnly(item.date));
            const today = startOfDay(new Date());

            if (item.status === 'completed') {
                return { key: 'paid', group: 'paid', label: pageText.statusPaidLabel || 'Paga', pillClass: 'status-pill status-pill--paid', rowClass: 'payables-row--paid', iconClass: 'payable-status-icon payable-status-icon--paid', iconName: 'fa-check' };
            }
            if (dueDate.getTime() < today.getTime()) {
                return { key: 'overdue', group: 'overdue', label: pageText.statusOverdueLabel || 'Vencida', pillClass: 'status-pill status-pill--overdue', rowClass: 'payables-row--overdue', iconClass: 'payable-status-icon payable-status-icon--overdue', iconName: 'fa-triangle-exclamation' };
            }
            if (dueDate.getTime() === today.getTime()) {
                return { key: 'due-today', group: 'due-today', label: pageText.statusTodayLabel || 'Vence hoje', pillClass: 'status-pill status-pill--today', rowClass: 'payables-row--today', iconClass: 'payable-status-icon payable-status-icon--today', iconName: 'fa-clock' };
            }
            if (item.status === 'scheduled') {
                return { key: 'scheduled', group: 'pending', label: pageText.statusScheduledLabel || 'Agendada', pillClass: 'status-pill status-pill--scheduled', rowClass: 'payables-row--scheduled', iconClass: 'payable-status-icon payable-status-icon--scheduled', iconName: 'fa-calendar-day' };
            }
            return { key: 'pending', group: 'pending', label: pageText.statusPendingLabel || 'Pendente', pillClass: 'status-pill status-pill--pending', rowClass: 'payables-row--pending', iconClass: 'payable-status-icon payable-status-icon--pending', iconName: 'fa-circle' };
        }

        function buildObservation(item, displayStatus) {
            const dueDate = parseDateOnly(item.date);
            const today = startOfDay(new Date());
            const diffDays = Math.floor((startOfDay(dueDate).getTime() - today.getTime()) / 86400000);

            if (displayStatus.key === 'paid') return pageText.observationPaid || 'Pagamento registrado no sistema.';
            if (displayStatus.key === 'overdue') return `Em atraso ha ${Math.abs(diffDays)} dia(s).`;
            if (displayStatus.key === 'due-today') return pageText.observationToday || 'Compromisso previsto para hoje.';
            if (displayStatus.key === 'scheduled') return pageText.observationScheduled || 'Pagamento agendado para esta data.';
            return pageText.observationPending || 'Aguardando baixa financeira.';
        }

        function getMonthBaseItems() {
            return state.items.filter((item) => sameMonth(parseDateOnly(item.date), state.monthCursor));
        }

        function matchesSearch(item) {
            if (!state.search) return true;
            return item.description.toLowerCase().includes(state.search) || item.category.toLowerCase().includes(state.search);
        }

        function matchesStatusFilter(item) {
            if (state.statusFilter === 'all') return true;
            const displayStatus = getDisplayStatus(item);
            if (state.statusFilter === 'pending') return displayStatus.group === 'pending';
            return displayStatus.group === state.statusFilter;
        }

        function sortItems(items) {
            const order = { overdue: 0, 'due-today': 1, scheduled: 2, pending: 3, paid: 4 };
            return [...items].sort((left, right) => {
                const leftStatus = getDisplayStatus(left);
                const rightStatus = getDisplayStatus(right);
                const rankDiff = (order[leftStatus.key] ?? 9) - (order[rightStatus.key] ?? 9);
                if (rankDiff !== 0) return rankDiff;

                const leftDate = parseDateOnly(left.date).getTime();
                const rightDate = parseDateOnly(right.date).getTime();
                if (leftStatus.group === 'paid' && rightStatus.group === 'paid') {
                    if (leftDate !== rightDate) return rightDate - leftDate;
                } else if (leftDate !== rightDate) {
                    return leftDate - rightDate;
                }
                return right.amount - left.amount;
            });
        }

        function getFilteredItems() {
            return sortItems(getMonthBaseItems().filter(matchesSearch).filter(matchesStatusFilter));
        }

        function getPaginationMeta(totalItems) {
            const totalPages = Math.max(1, Math.ceil(totalItems / state.pageSize));
            const currentPage = Math.min(state.page, totalPages);
            const start = totalItems === 0 ? 0 : ((currentPage - 1) * state.pageSize) + 1;
            const end = totalItems === 0 ? 0 : Math.min(currentPage * state.pageSize, totalItems);
            state.page = currentPage;
            return { totalPages, currentPage, start, end };
        }

        function buildPaginationSequence(currentPage, totalPages) {
            if (totalPages <= 7) return Array.from({ length: totalPages }, (_, index) => index + 1);

            const pages = new Set([1, totalPages, currentPage, currentPage - 1, currentPage + 1]);
            if (currentPage <= 3) {
                pages.add(2); pages.add(3); pages.add(4);
            }
            if (currentPage >= totalPages - 2) {
                pages.add(totalPages - 1); pages.add(totalPages - 2); pages.add(totalPages - 3);
            }

            const sorted = [...pages].filter((page) => page >= 1 && page <= totalPages).sort((a, b) => a - b);
            const sequence = [];
            sorted.forEach((page, index) => {
                if (index > 0 && page - sorted[index - 1] > 1) sequence.push('...');
                sequence.push(page);
            });
            return sequence;
        }

        function renderMonthSwitcher() {
            const months = [-1, 0, 1].map((offset) => addMonths(state.monthCursor, offset));
            monthSwitcher.innerHTML = months.map((date) => {
                const iso = toDateInputValue(date);
                const active = sameMonth(date, state.monthCursor);
                return `<button type="button" class="month-switcher-btn ${active ? 'is-active' : ''}" data-month-value="${iso}" ${active ? 'aria-current="true"' : ''}>${escapeHtml(formatMonthLabel(date))}</button>`;
            }).join('');
        }

        function renderStatusFilters() {
            statusFilters.innerHTML = STATUS_FILTERS.map((filter) => `
                <button type="button" class="filter-chip ${filter.key === state.statusFilter ? 'is-active' : ''}" data-status-filter="${filter.key}" ${filter.key === state.statusFilter ? 'aria-current="true"' : ''}>${escapeHtml(filter.label)}</button>
            `).join('');
        }

        function renderSummary(baseItems) {
            const counts = baseItems.reduce((accumulator, item) => {
                const group = getDisplayStatus(item).group;
                if (group === 'overdue') accumulator.overdue += 1;
                if (group === 'due-today') accumulator.dueToday += 1;
                if (group === 'pending') accumulator.pending += 1;
                return accumulator;
            }, { overdue: 0, dueToday: 0, pending: 0 });

            summaryOverdue.textContent = `${counts.overdue} ${pageText.summaryOverdueSuffix || 'vencidas'}`;
            summaryDueToday.textContent = `${counts.dueToday} ${pageText.summaryTodaySuffix || 'vence hoje'}`;
            summaryPending.textContent = `${counts.pending} ${pageText.summaryPendingSuffix || 'pendentes'}`;
        }

        function buildDesktopRow(item) {
            const displayStatus = getDisplayStatus(item);
            const note = buildObservation(item, displayStatus);
            const dueClass = displayStatus.group === 'overdue' ? 'payable-due payable-due--overdue'
                : displayStatus.group === 'due-today' ? 'payable-due payable-due--today'
                    : 'payable-due';
            const selectable = isSelectableStatus(displayStatus);
            const checked = selectable && state.selectedIds.has(item.id);
            return `
                <tr class="payables-row table-row ${displayStatus.rowClass}">
                    <td class="payable-select-cell">
                        ${selectable ? `<input type="checkbox" class="payable-select-checkbox" data-payable-select="${escapeHtml(item.id)}" ${checked ? 'checked' : ''} aria-label="Selecionar conta">` : ''}
                    </td>
                    <td>
                        <div class="payable-main">
                            <span class="${displayStatus.iconClass}"><i class="fas ${displayStatus.iconName}"></i></span>
                            <div class="min-w-0">
                                <p class="payable-title">${escapeHtml(item.description || 'Conta sem descricao')}</p>
                                <p class="payable-subtitle">${escapeHtml(item.category || 'Sem categoria')}</p>
                            </div>
                        </div>
                    </td>
                    <td><span class="payable-amount">${escapeHtml(formatAmountPlain(item.amount))}</span></td>
                    <td><span class="${dueClass}">${escapeHtml(formatDate(item.date))}</span></td>
                    <td><span class="${displayStatus.pillClass}">${escapeHtml(displayStatus.label)}</span></td>
                    <td><p class="payable-note">${escapeHtml(note)}</p></td>
                    <td>
                        <div class="row-actions">
                            ${displayStatus.group !== 'paid' ? `<button type="button" class="row-complete-mini-btn" data-payable-action="complete" data-payable-id="${escapeHtml(item.id)}">${escapeHtml(pageText.actionCompleteLabel || 'Pagar')}</button>` : ''}
                            <button type="button" class="action-btn action-btn-view" data-payable-action="view" data-payable-id="${escapeHtml(item.id)}" title="Detalhes" aria-label="Detalhes">
                                <i class="fas fa-eye"></i>
                            </button>
                            <button type="button" class="action-btn action-btn-edit" data-payable-action="edit" data-payable-id="${escapeHtml(item.id)}" title="Editar" aria-label="Editar">
                                <i class="fas fa-pen-to-square"></i>
                            </button>
                            <button type="button" class="action-btn action-btn-delete" data-payable-action="delete" data-payable-id="${escapeHtml(item.id)}" title="Excluir" aria-label="Excluir">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            `;
        }

        function buildMobileCard(item) {
            const displayStatus = getDisplayStatus(item);
            const note = buildObservation(item, displayStatus);
            const selectable = isSelectableStatus(displayStatus);
            const checked = selectable && state.selectedIds.has(item.id);
            return `
                <article class="mobile-card mobile-card--${displayStatus.key}">
                    <div class="flex items-start justify-between gap-3">
                        <div class="payable-main min-w-0">
                            <span class="${displayStatus.iconClass}"><i class="fas ${displayStatus.iconName}"></i></span>
                            <div class="min-w-0">
                                <p class="payable-title">${escapeHtml(item.description || 'Conta sem descricao')}</p>
                                <p class="payable-subtitle">${escapeHtml(item.category || 'Sem categoria')}</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            ${selectable ? `<label class="mobile-card-select"><input type="checkbox" class="payable-select-checkbox" data-payable-select="${escapeHtml(item.id)}" ${checked ? 'checked' : ''}> <span>Sel.</span></label>` : ''}
                            <span class="${displayStatus.pillClass}">${escapeHtml(displayStatus.label)}</span>
                        </div>
                    </div>
                    <div class="mobile-card-grid">
                        <div><p class="mobile-card-label">Valor</p><p class="mobile-card-value">${escapeHtml(formatCurrency(item.amount))}</p></div>
                        <div><p class="mobile-card-label">${escapeHtml(pageText.tableDateHeader || 'Vencimento')}</p><p class="mobile-card-value">${escapeHtml(formatDate(item.date))}</p></div>
                        <div class="col-span-2"><p class="mobile-card-label">Observacoes</p><p class="mobile-card-value">${escapeHtml(note)}</p></div>
                    </div>
                    <div class="mobile-card-actions">
                        ${displayStatus.group !== 'paid' ? `<button type="button" class="row-complete-mini-btn" data-payable-action="complete" data-payable-id="${escapeHtml(item.id)}">${escapeHtml(pageText.actionCompleteLabel || 'Pagar')}</button>` : ''}
                        <button type="button" class="action-btn action-btn-view" data-payable-action="view" data-payable-id="${escapeHtml(item.id)}" title="Detalhes" aria-label="Detalhes">
                            <i class="fas fa-eye"></i>
                        </button>
                        <button type="button" class="action-btn action-btn-edit" data-payable-action="edit" data-payable-id="${escapeHtml(item.id)}" title="Editar" aria-label="Editar">
                            <i class="fas fa-pen-to-square"></i>
                        </button>
                        <button type="button" class="action-btn action-btn-delete" data-payable-action="delete" data-payable-id="${escapeHtml(item.id)}" title="Excluir" aria-label="Excluir">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </article>
            `;
        }

        function renderEmptyState(target, isTable) {
            const content = `
                <div class="table-empty">
                    <div class="table-empty-icon"><i class="fas fa-file-invoice-dollar"></i></div>
                    <p class="table-empty-title">${escapeHtml(pageText.emptyTitle || 'Nenhuma conta encontrada.')}</p>
                    <p class="table-empty-note">${escapeHtml(pageText.emptyNote || 'Ajuste os filtros ou cadastre uma nova conta para preencher esta lista.')}</p>
                </div>
            `;
            if (isTable) {
                target.innerHTML = `<tr><td colspan="7">${content}</td></tr>`;
                return;
            }
            target.innerHTML = content;
        }

        function renderPagination(totalItems) {
            const { totalPages, currentPage, start, end } = getPaginationMeta(totalItems);
            const noun = totalItems === 1 ? (pageText.paginationSingular || 'conta') : (pageText.paginationPlural || 'contas');
            paginationInfo.textContent = `Mostrando ${start}-${end} de ${totalItems} ${noun}`;
            if (totalItems <= state.pageSize) {
                paginationControls.innerHTML = '';
                return;
            }
            const pages = buildPaginationSequence(currentPage, totalPages);
            paginationControls.innerHTML = [
                `<button type="button" class="panel-page-btn" data-payable-page="${currentPage - 1}" ${currentPage <= 1 ? 'disabled' : ''}>Anterior</button>`,
                ...pages.map((page) => typeof page === 'number'
                    ? `<button type="button" class="panel-page-btn ${page === currentPage ? 'is-active' : ''}" data-payable-page="${page}" ${page === currentPage ? 'aria-current="page"' : ''}>${page}</button>`
                    : '<span class="panel-page-ellipsis">...</span>'),
                `<button type="button" class="panel-page-btn" data-payable-page="${currentPage + 1}" ${currentPage >= totalPages ? 'disabled' : ''}>Proxima</button>`,
            ].join('');
        }

        function renderPayables() {
            const monthBaseItems = getMonthBaseItems();
            renderSummary(monthBaseItems);

            const filteredItems = getFilteredItems();
            state.filteredSelectableIds = filteredItems
                .filter((item) => isSelectableStatus(getDisplayStatus(item)))
                .map((item) => item.id);
            pruneSelectionByFilteredItems();
            const { currentPage } = getPaginationMeta(filteredItems.length);
            const startIndex = (currentPage - 1) * state.pageSize;
            const visibleItems = filteredItems.slice(startIndex, startIndex + state.pageSize);
            state.visibleSelectableIds = visibleItems
                .filter((item) => isSelectableStatus(getDisplayStatus(item)))
                .map((item) => item.id);

            if (!visibleItems.length) {
                renderEmptyState(payablesTableBody, true);
                renderEmptyState(payablesMobileList, false);
                renderPagination(filteredItems.length);
                renderBulkSelectionUi();
                return;
            }

            payablesTableBody.innerHTML = visibleItems.map(buildDesktopRow).join('');
            payablesMobileList.innerHTML = visibleItems.map(buildMobileCard).join('');
            renderPagination(filteredItems.length);
            renderBulkSelectionUi();
        }

        async function fetchTransactions(preserveMonthCursor = false) {
            const response = await fetch('/api/finance/transactions', { credentials: 'include' });
            const payload = await response.json().catch(() => null);
            if (!response.ok) throw new Error(payload?.message || pageText.loadError || 'Falha ao carregar as contas a pagar.');

            const items = Array.isArray(payload?.data) ? payload.data.map(normalizeTransaction).filter(matchesPageTransaction) : [];
            state.items = items;
            const availableIds = new Set(items.map((item) => item.id));
            state.selectedIds.forEach((id) => {
                if (!availableIds.has(id)) state.selectedIds.delete(id);
            });
            if (!preserveMonthCursor) {
                state.monthCursor = items.length
                    ? startOfMonth(parseDateOnly([...items].sort((left, right) => parseDateOnly(right.date) - parseDateOnly(left.date))[0].date))
                    : startOfMonth(new Date());
            } else if (!items.length) {
                state.monthCursor = startOfMonth(new Date());
            }
            state.page = 1;
            state.openMenuId = null;
        }

        async function loadPayables(preserveMonthCursor = false) {
            setScreenLoading(true);
            hideError();
            try {
                await fetchTransactions(preserveMonthCursor);
                renderMonthSwitcher();
                renderStatusFilters();
                renderPayables();
            } catch (error) {
                console.error(error);
                showError(error instanceof Error ? error.message : pageText.loadError || 'Falha ao carregar as contas a pagar.');
                payablesTableBody.innerHTML = '';
                payablesMobileList.innerHTML = '';
                paginationControls.innerHTML = '';
                paginationInfo.textContent = `Mostrando 0-0 de 0 ${pageText.paginationPlural || 'contas'}`;
                state.selectedIds.clear();
                state.filteredSelectableIds = [];
                state.visibleSelectableIds = [];
                renderBulkSelectionUi();
            } finally {
                setScreenLoading(false);
            }
        }

        function releaseBodyScrollIfNoModal() {
            if (
                payableModal.classList.contains('hidden')
                && payableViewModal.classList.contains('hidden')
                && payableDeleteModal.classList.contains('hidden')
            ) {
                document.body.style.overflow = '';
            }
        }

        function openPayableModal(item = null, mode = 'create') {
            const isEditMode = mode === 'edit' && Boolean(item);

            state.editingId = isEditMode ? (item?.id || null) : null;
            payableModalTitle.textContent = isEditMode ? (pageText.modalEditTitle || 'Editar conta') : (pageText.modalNewTitle || 'Nova conta');
            payableModalSubtitle.textContent = isEditMode
                ? (pageText.modalEditSubtitle || 'Ajuste os dados financeiros antes de salvar a alteracao.')
                : (pageText.modalNewSubtitle || 'Cadastre uma obrigacao financeira do modulo.');
            savePayableBtn.textContent = isEditMode ? (pageText.modalSaveEditLabel || 'Salvar alteracoes') : (pageText.modalSaveNewLabel || 'Salvar conta');
            payableDescriptionInput.value = item?.description || '';
            payableCategoryInput.value = item?.category || '';
            payableAmountInput.value = item ? String(Number(item.amount || 0)) : '';
            if (payableEntryTypeInput instanceof HTMLSelectElement) payableEntryTypeInput.value = 'single';
            if (payableInstallmentCountInput instanceof HTMLInputElement) payableInstallmentCountInput.value = '4';
            if (payableInstallmentAmountModeInput instanceof HTMLSelectElement) payableInstallmentAmountModeInput.value = 'total';
            if (payableRecurringMonthsInput instanceof HTMLInputElement) payableRecurringMonthsInput.value = '12';
            payableDateInput.value = item?.date || toDateInputValue(new Date());
            payableStatusInput.value = item?.status || 'pending';
            savePayableBtn.classList.remove('hidden');
            savePayableBtn.disabled = false;
            cancelPayableModalBtn.textContent = 'Cancelar';
            syncInstallmentModeUi();
            payableModal.classList.remove('hidden');
            payableModal.classList.add('flex');
            document.body.style.overflow = 'hidden';
            window.setTimeout(() => payableDescriptionInput.focus(), 0);
        }

        function closePayableModal() {
            state.editingId = null;
            payableModal.classList.add('hidden');
            payableModal.classList.remove('flex');
            releaseBodyScrollIfNoModal();
            payableForm.reset();
            if (payableEntryTypeInput instanceof HTMLSelectElement) payableEntryTypeInput.value = 'single';
            if (payableInstallmentCountInput instanceof HTMLInputElement) payableInstallmentCountInput.value = '4';
            if (payableInstallmentAmountModeInput instanceof HTMLSelectElement) payableInstallmentAmountModeInput.value = 'total';
            if (payableRecurringMonthsInput instanceof HTMLInputElement) payableRecurringMonthsInput.value = '12';
            syncInstallmentModeUi();
        }

        function openPayableViewModal(item) {
            if (!item) return;
            const displayStatus = getDisplayStatus(item);
            const observation = buildObservation(item, displayStatus);

            state.viewingId = item.id;
            payableViewTitle.textContent = pageText.mode === 'income' ? 'Detalhes da conta a receber' : 'Detalhes da conta a pagar';
            payableViewSubtitle.textContent = pageText.mode === 'income'
                ? 'Visualize as informacoes deste recebimento.'
                : 'Visualize as informacoes desta conta.';
            payableViewDescription.textContent = item.description || 'Conta sem descricao';
            payableViewCategory.textContent = item.category || 'Sem categoria';
            payableViewAmount.textContent = formatCurrency(item.amount);
            payableViewDate.textContent = formatDate(item.date);
            payableViewStatusText.textContent = displayStatus.label;
            payableViewObservation.textContent = observation;
            payableViewStatusBadge.className = displayStatus.pillClass;
            payableViewStatusBadge.textContent = displayStatus.label;
            openPayableEditFromViewBtn.textContent = pageText.mode === 'income' ? 'Editar recebimento' : 'Editar conta';

            payableViewModal.classList.remove('hidden');
            payableViewModal.classList.add('flex');
            document.body.style.overflow = 'hidden';
            window.setTimeout(() => closePayableViewModalBtn.focus(), 0);
        }

        function closePayableViewModal() {
            state.viewingId = null;
            payableViewModal.classList.add('hidden');
            payableViewModal.classList.remove('flex');
            releaseBodyScrollIfNoModal();
        }

        function setDeleteLoading(loading) {
            state.deleting = loading;
            if (closePayableDeleteModalBtn instanceof HTMLButtonElement) closePayableDeleteModalBtn.disabled = loading;
            if (cancelPayableDeleteBtn instanceof HTMLButtonElement) cancelPayableDeleteBtn.disabled = loading;
            if (!(confirmPayableDeleteBtn instanceof HTMLButtonElement)) return;
            confirmPayableDeleteBtn.disabled = loading;
            const deleteLabel = pageText.mode === 'income' ? 'Excluir recebimento' : 'Excluir conta';
            confirmPayableDeleteBtn.textContent = loading ? 'Excluindo...' : deleteLabel;
        }

        function openDeleteConfirmModal(item) {
            if (!item) return;
            state.deletingId = String(item.id);
            if (payableDeleteTitle instanceof HTMLElement) {
                payableDeleteTitle.textContent = pageText.mode === 'income' ? 'Confirmar exclusao do recebimento' : 'Confirmar exclusao da conta';
            }
            const baseText = pageText.mode === 'income' ? 'este recebimento' : 'esta conta';
            const description = item.description ? ` "${item.description}"` : '';
            payableDeleteMessage.textContent = `Deseja excluir ${baseText}${description}?`;
            setDeleteLoading(false);
            payableDeleteModal.classList.remove('hidden');
            payableDeleteModal.classList.add('flex');
            document.body.style.overflow = 'hidden';
            window.setTimeout(() => confirmPayableDeleteBtn.focus(), 0);
        }

        function closeDeleteConfirmModal(force = false) {
            if (state.deleting && !force) return;
            state.deletingId = null;
            setDeleteLoading(false);
            payableDeleteModal.classList.add('hidden');
            payableDeleteModal.classList.remove('flex');
            releaseBodyScrollIfNoModal();
        }

        async function confirmDeletePayable() {
            if (state.deleting || !state.deletingId) return;
            setDeleteLoading(true);
            try {
                const response = await fetch(`/api/finance/transactions/${encodeURIComponent(state.deletingId)}`, {
                    method: 'DELETE',
                    credentials: 'include',
                });
                if (!response.ok && response.status !== 204) {
                    const body = await response.json().catch(() => null);
                    throw new Error(body?.message || pageText.deleteError || 'Falha ao excluir a conta.');
                }
                state.selectedIds.delete(String(state.deletingId));
                closeDeleteConfirmModal(true);
                await loadPayables(true);
                notify(pageText.deleteSuccess || 'Conta excluida com sucesso.', 'success');
            } catch (error) {
                console.error(error);
                notify(error instanceof Error ? error.message : pageText.deleteError || 'Falha ao excluir a conta.', 'error');
                setDeleteLoading(false);
            }
        }

        async function savePayable(event) {
            event.preventDefault();
            if (state.saving) return;

            const isEditing = Boolean(state.editingId);
            const description = payableDescriptionInput.value.trim();
            const category = payableCategoryInput.value.trim();
            const amount = Number(payableAmountInput.value);
            const date = payableDateInput.value;
            const status = payableStatusInput.value;
            const entryType = isEditing ? 'single' : getEntryTypeValue();
            const installmentCount = entryType === 'installments'
                ? Number(payableInstallmentCountInput instanceof HTMLInputElement ? payableInstallmentCountInput.value : 0)
                : 1;
            const recurringMonths = entryType === 'recurring_monthly'
                ? Number(payableRecurringMonthsInput instanceof HTMLInputElement ? payableRecurringMonthsInput.value : 0)
                : 1;
            const installmentAmountMode = getInstallmentAmountModeValue();

            if (!description || !category) return notify('Preencha descricao e categoria.', 'error');
            if (!Number.isFinite(amount) || amount <= 0) return notify('Informe um valor maior que zero.', 'error');
            if (!date) return notify('Informe uma data de vencimento valida.', 'error');
            if (!['pending', 'scheduled', 'completed'].includes(status)) return notify('Situacao invalida.', 'error');
            if (entryType === 'installments') {
                if (!Number.isInteger(installmentCount) || installmentCount < 2 || installmentCount > 60) {
                    return notify('Informe uma quantidade de parcelas entre 2 e 60.', 'error');
                }
            }
            if (entryType === 'recurring_monthly') {
                if (!Number.isInteger(recurringMonths) || recurringMonths < 2 || recurringMonths > 120) {
                    return notify('Informe uma quantidade de meses entre 2 e 120.', 'error');
                }
            }

            setSaving(true);

            try {
                const payload = { type: pageText.itemType || 'expense', amount, category, date, description, status };
                if (!isEditing && entryType === 'installments') {
                    payload.creationMode = 'installments';
                    payload.installmentCount = installmentCount;
                    payload.installmentAmountMode = installmentAmountMode;
                }
                if (!isEditing && entryType === 'recurring_monthly') {
                    payload.creationMode = 'recurring_monthly';
                    payload.recurringMonths = recurringMonths;
                }
                const response = await fetch(
                    isEditing ? `/api/finance/transactions/${encodeURIComponent(state.editingId)}` : '/api/finance/transactions',
                    {
                        method: isEditing ? 'PATCH' : 'POST',
                        credentials: 'include',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload),
                    },
                );
                const body = await response.json().catch(() => null);
                if (!response.ok) throw new Error(body?.message || pageText.saveError || 'Falha ao salvar a conta.');

                state.monthCursor = startOfMonth(parseDateOnly(date));
                state.page = 1;
                state.statusFilter = 'all';
                state.search = '';
                searchInput.value = '';
                closePayableModal();
                await loadPayables(true);
                if (!isEditing && entryType === 'installments') {
                    const createdCount = Number(body?.data?.createdCount || installmentCount);
                    notify(`${createdCount} parcela(s) cadastrada(s) com sucesso.`, 'success');
                } else if (!isEditing && entryType === 'recurring_monthly') {
                    const createdCount = Number(body?.data?.createdCount || recurringMonths);
                    notify(`${createdCount} lancamento(s) mensal(is) cadastrado(s) com sucesso.`, 'success');
                } else {
                    notify(isEditing ? (pageText.saveSuccessEdit || 'Conta atualizada com sucesso.') : (pageText.saveSuccessCreate || 'Conta cadastrada com sucesso.'), 'success');
                }
            } catch (error) {
                console.error(error);
                notify(error instanceof Error ? error.message : pageText.saveError || 'Falha ao salvar a conta.', 'error');
            } finally {
                setSaving(false);
            }
        }

        async function completePayable(id) {
            try {
                const response = await fetch(`/api/finance/transactions/${encodeURIComponent(id)}`, {
                    method: 'PATCH',
                    credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status: 'completed' }),
                });
                const body = await response.json().catch(() => null);
                if (!response.ok) throw new Error(body?.message || pageText.completeError || 'Falha ao baixar a conta.');
                state.selectedIds.delete(String(id));
                await loadPayables(true);
                notify(pageText.completeSuccess || 'Conta baixada com sucesso.', 'success');
            } catch (error) {
                console.error(error);
                notify(error instanceof Error ? error.message : pageText.completeError || 'Falha ao baixar a conta.', 'error');
            }
        }

        async function completeSelectedPayables() {
            if (state.bulkCompleting) return;
            const ids = [...state.selectedIds];
            if (!ids.length) return;

            const selectedItems = state.items.filter((item) => state.selectedIds.has(item.id));
            const selectedTotal = selectedItems.reduce((acc, item) => acc + (Number(item.amount) || 0), 0);
            const actionLabel = getCompleteActionLabel();
            const confirmText = `Confirmar ${actionLabel.toLowerCase()} ${ids.length} conta(s), total ${formatCurrency(selectedTotal)}?`;
            if (!window.confirm(confirmText)) return;

            setBulkCompleting(true);
            try {
                const response = await fetch('/api/finance/transactions/batch-complete', {
                    method: 'POST',
                    credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ids }),
                });
                const body = await response.json().catch(() => null);
                if (!response.ok) throw new Error(body?.message || 'Falha ao processar as contas selecionadas.');

                const updatedCount = Number(body?.data?.updatedCount || 0);
                const alreadyCompletedCount = Array.isArray(body?.data?.alreadyCompletedIds) ? body.data.alreadyCompletedIds.length : 0;
                const notFoundCount = Array.isArray(body?.data?.notFoundIds) ? body.data.notFoundIds.length : 0;

                state.selectedIds.clear();
                await loadPayables(true);

                const details = [];
                if (alreadyCompletedCount > 0) details.push(`${alreadyCompletedCount} ja estavam concluídas`);
                if (notFoundCount > 0) details.push(`${notFoundCount} nao encontradas`);
                const detailsText = details.length ? ` (${details.join(' | ')})` : '';
                notify(`${updatedCount} conta(s) processada(s) com sucesso.${detailsText}`, 'success');
            } catch (error) {
                console.error(error);
                notify(error instanceof Error ? error.message : 'Falha ao processar as contas selecionadas.', 'error');
            } finally {
                setBulkCompleting(false);
                renderBulkSelectionUi();
            }
        }

        function deletePayable(item) {
            openDeleteConfirmModal(item);
        }

        function closeMenus() {
            state.openMenuId = null;
            document.querySelectorAll('[data-payable-menu]').forEach((menu) => menu.classList.add('hidden'));
        }

        function openMenu(id) {
            if (state.openMenuId === id) return closeMenus();
            state.openMenuId = id;
            document.querySelectorAll('[data-payable-menu]').forEach((menu) => {
                menu.classList.toggle('hidden', menu.getAttribute('data-payable-menu') !== id);
            });
        }

        function syncSidebarLayout() {
            if (isMobileViewport()) {
                main.style.marginLeft = '0';
                main.style.width = '100%';
                main.style.flex = '1 1 100%';
                return;
            }
            sidebar.classList.remove('mobile-open');
            if (document.body.classList.contains('sidebar-collapsed')) {
                main.style.marginLeft = '0';
                main.style.width = '100%';
                main.style.flex = '1 1 100%';
                return;
            }
            main.style.marginLeft = '16rem';
            main.style.width = 'calc(100% - 16rem)';
            main.style.flex = '0 1 calc(100% - 16rem)';
        }

        function closeUserMenu() {
            if (userMenuDropdown) userMenuDropdown.classList.add('hidden');
        }

        async function performLogout() {
            localStorage.removeItem('isLoggedIn');
            localStorage.removeItem('currentUser');
            await fetch('/auth/logout', { method: 'POST', credentials: 'include' });
            window.location.href = '/login';
        }

        async function handleUserMenuAction(action) {
            if (action === 'logout') return performLogout();
            const allowedTabs = new Set(['profile', 'security', 'help']);
            window.location.href = `/admin/account.html?tab=${encodeURIComponent(allowedTabs.has(action) ? action : 'profile')}`;
        }

        sidebarToggle.addEventListener('click', () => {
            if (isMobileViewport()) {
                sidebar.classList.toggle('mobile-open');
                return;
            }
            document.body.classList.toggle('sidebar-collapsed');
            syncSidebarLayout();
        });

        openPayableModalBtn.addEventListener('click', () => openPayableModal(null, 'create'));
        closePayableModalBtn.addEventListener('click', closePayableModal);
        cancelPayableModalBtn.addEventListener('click', closePayableModal);
        if (payableEntryTypeInput instanceof HTMLSelectElement) {
            payableEntryTypeInput.addEventListener('change', syncInstallmentModeUi);
        }
        if (payableInstallmentAmountModeInput instanceof HTMLSelectElement) {
            payableInstallmentAmountModeInput.addEventListener('change', syncInstallmentModeUi);
        }
        closePayableViewModalBtn.addEventListener('click', closePayableViewModal);
        closePayableViewFooterBtn.addEventListener('click', closePayableViewModal);
        closePayableDeleteModalBtn.addEventListener('click', closeDeleteConfirmModal);
        cancelPayableDeleteBtn.addEventListener('click', closeDeleteConfirmModal);
        confirmPayableDeleteBtn.addEventListener('click', confirmDeletePayable);
        openPayableEditFromViewBtn.addEventListener('click', () => {
            const item = state.items.find((entry) => entry.id === state.viewingId);
            closePayableViewModal();
            if (item) openPayableModal(item, 'edit');
        });
        if (payablesSelectAllCheckbox instanceof HTMLInputElement) {
            payablesSelectAllCheckbox.addEventListener('change', (event) => {
                const target = event.target;
                if (!(target instanceof HTMLInputElement)) return;
                const shouldSelect = target.checked;
                state.visibleSelectableIds.forEach((id) => {
                    if (shouldSelect) {
                        state.selectedIds.add(id);
                    } else {
                        state.selectedIds.delete(id);
                    }
                });
                renderPayables();
            });
        }
        if (bulkCompleteBtn instanceof HTMLButtonElement) {
            bulkCompleteBtn.addEventListener('click', completeSelectedPayables);
        }
        payableForm.addEventListener('submit', savePayable);

        searchInput.addEventListener('input', (event) => {
            state.search = String(event.target.value || '').trim().toLowerCase();
            state.page = 1;
            closeMenus();
            renderPayables();
        });

        monthSwitcher.addEventListener('click', (event) => {
            const target = event.target;
            if (!(target instanceof HTMLElement)) return;
            const button = target.closest('[data-month-value]');
            if (!(button instanceof HTMLButtonElement)) return;
            const nextMonth = parseDateOnly(button.getAttribute('data-month-value'));
            if (Number.isNaN(nextMonth.getTime())) return;
            state.monthCursor = startOfMonth(nextMonth);
            state.page = 1;
            closeMenus();
            renderMonthSwitcher();
            renderPayables();
        });

        statusFilters.addEventListener('click', (event) => {
            const target = event.target;
            if (!(target instanceof HTMLElement)) return;
            const button = target.closest('[data-status-filter]');
            if (!(button instanceof HTMLButtonElement)) return;
            state.statusFilter = button.getAttribute('data-status-filter') || 'all';
            state.page = 1;
            closeMenus();
            renderStatusFilters();
            renderPayables();
        });

        paginationControls.addEventListener('click', (event) => {
            const target = event.target;
            if (!(target instanceof HTMLElement)) return;
            const button = target.closest('[data-payable-page]');
            if (!(button instanceof HTMLButtonElement) || button.disabled) return;
            const page = Number(button.getAttribute('data-payable-page'));
            if (!Number.isFinite(page) || page < 1) return;
            state.page = page;
            renderPayables();
        });

        [payablesTableBody, payablesMobileList].forEach((container) => {
            container.addEventListener('change', (event) => {
                const target = event.target;
                if (!(target instanceof HTMLElement)) return;
                const checkbox = target.closest('[data-payable-select]');
                if (!(checkbox instanceof HTMLInputElement)) return;
                const payableId = checkbox.getAttribute('data-payable-select');
                if (!payableId) return;
                if (checkbox.checked) {
                    state.selectedIds.add(payableId);
                } else {
                    state.selectedIds.delete(payableId);
                }
                renderBulkSelectionUi();
            });

            container.addEventListener('click', async (event) => {
                const target = event.target;
                if (!(target instanceof HTMLElement)) return;
                const actionButton = target.closest('[data-payable-action]');
                if (!(actionButton instanceof HTMLButtonElement)) return;

                const action = actionButton.getAttribute('data-payable-action');
                const payableId = actionButton.getAttribute('data-payable-id');
                if (!action || !payableId) return;

                if (action === 'toggle-menu') {
                    event.preventDefault();
                    event.stopPropagation();
                    openMenu(payableId);
                    return;
                }

                closeMenus();
                const item = state.items.find((entry) => entry.id === payableId);
                if (!item) return;

                if (action === 'view') return openPayableViewModal(item);
                if (action === 'edit') return openPayableModal(item, 'edit');
                if (action === 'delete') return deletePayable(item);
                if (action === 'complete') await completePayable(payableId);
            });
        });

        userMenuBtn.addEventListener('click', (event) => {
            event.stopPropagation();
            userMenuDropdown.classList.toggle('hidden');
        });

        document.addEventListener('click', async (event) => {
            const target = event.target;
            if (!(target instanceof HTMLElement)) return;

            const actionBtn = target.closest('[data-user-menu-action]');
            if (actionBtn) {
                const action = actionBtn.getAttribute('data-user-menu-action');
                closeUserMenu();
                if (action) await handleUserMenuAction(action);
                return;
            }

            if (!target.closest('[data-payable-menu]') && !target.closest('[data-payable-action="toggle-menu"]')) closeMenus();
            if (!target.closest('#userMenuBtn') && !target.closest('#userMenuDropdown')) closeUserMenu();
            if (target === payableModal) closePayableModal();
            if (target === payableViewModal) closePayableViewModal();
            if (target === payableDeleteModal) closeDeleteConfirmModal();
        });

        document.addEventListener('keydown', (event) => {
            if (!(event instanceof KeyboardEvent)) return;
            if (event.key === 'Escape') {
                closeMenus();
                if (!payableModal.classList.contains('hidden')) closePayableModal();
                if (!payableViewModal.classList.contains('hidden')) closePayableViewModal();
                if (!payableDeleteModal.classList.contains('hidden')) closeDeleteConfirmModal();
            }
        });

        window.addEventListener('resize', syncSidebarLayout);
        syncSidebarLayout();
        syncInstallmentModeUi();
        loadPayables();
    </script>
</body>
</html>
