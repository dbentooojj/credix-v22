<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Credix - Painel da Carteira</title>
    <%- include('partials/favicon') %>
    <%- include('partials/toast') %>
    <%- include('partials/session-timeout') %>
    <style>
        html, body { background-color: #020617; }
    </style>
    <script>
        (function () {
            const root = document.documentElement;
            try {
                const savedTheme = localStorage.getItem('theme');
                if (savedTheme === 'dark') root.classList.add('dark');
                if (savedTheme === 'light') root.classList.remove('dark');
            } catch (error) {}
        })();

        window.tailwind = window.tailwind || {};
        window.tailwind.config = Object.assign({}, window.tailwind.config || {}, { darkMode: 'class' });
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        html { font-size: 16px; }
        body { font-family: 'Inter', sans-serif; overflow-x: hidden; }

        body.dashboard-premium {
            color: #f8fbff;
            background:
                radial-gradient(72rem 44rem at -8% -12%, rgba(37,99,235,.26), transparent 48%),
                radial-gradient(48rem 32rem at 100% 0%, rgba(6,182,212,.12), transparent 44%),
                linear-gradient(180deg, #050b17 0%, #08111f 100%);
        }

        body.dashboard-premium::before {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            opacity: .55;
            background:
                linear-gradient(180deg, rgba(255,255,255,.02), transparent 22%),
                radial-gradient(circle at 25% 20%, rgba(59,130,246,.08), transparent 24%);
            mix-blend-mode: screen;
        }

        .premium-header {
            background: rgba(12,18,32,.86);
            border-bottom: 1px solid rgba(148,163,184,.16);
            backdrop-filter: blur(10px);
        }

        .icon-btn {
            color: #cbd5e1;
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: .12s;
        }

        .icon-btn:hover {
            color: #fff;
            background: rgba(59,130,246,.16);
            box-shadow: inset 0 0 0 1px rgba(96,165,250,.24);
        }

        .modern-sidebar { transform: translateX(0); transition: transform .12s ease-out; }

        a:focus,
        a:focus-visible,
        button:focus,
        button:focus-visible,
        input:focus,
        input:focus-visible,
        select:focus,
        select:focus-visible,
        textarea:focus,
        textarea:focus-visible {
            outline: none !important;
        }

        .page-title {
            color: #f8fafc;
            font-size: clamp(2rem, 1.2vw + 1.2rem, 2.45rem);
            line-height: 1.04;
            font-weight: 700;
            letter-spacing: -.035em;
        }

        .muted-on-dark {
            color: #cbd5e1;
            font-size: .96rem;
            line-height: 1.6;
        }

        .glass-card,
        .kpi-card,
        .summary-link,
        .metric-strip-item,
        .health-mini-card,
        .chart-container,
        .dashboard-table-wrap {
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(148,163,184,.14);
            border-radius: 16px;
            background: linear-gradient(180deg, rgba(10,18,34,.96), rgba(9,16,30,.84));
            box-shadow: 0 10px 30px rgba(2,6,23,.28);
        }

        .glass-card::before,
        .kpi-card::before,
        .summary-link::before,
        .metric-strip-item::before,
        .health-mini-card::before,
        .chart-container::before,
        .dashboard-table-wrap::before {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: linear-gradient(180deg, rgba(255,255,255,.04), transparent 30%);
            opacity: .6;
        }

        .kpi-card {
            padding: 18px;
            min-height: 124px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .kpi-card.kpi-primary-positive {
            background: linear-gradient(140deg, rgba(16,185,129,.26), rgba(6,182,212,.2));
            border-color: rgba(16,185,129,.4);
        }

        #kpiReceivableCard {
            background: linear-gradient(140deg, rgba(14,41,105,.9), rgba(13,30,77,.84));
            border-color: rgba(59,130,246,.34);
        }

        .kpi-label {
            color: #e2e8f0;
            font-size: .8rem;
            font-weight: 500;
            letter-spacing: .04em;
            text-transform: uppercase;
            opacity: .95;
        }

        .kpi-value {
            margin-top: .55rem;
            color: #f8fafc;
            font-size: 2rem;
            line-height: 1.04;
            font-weight: 500;
            letter-spacing: -.03em;
        }

        .kpi-note {
            margin-top: .45rem;
            color: rgba(226,232,240,.84);
            font-size: .86rem;
            line-height: 1.45;
            font-weight: 600;
        }

        .kpi-info {
            color: rgba(226,232,240,.82);
            cursor: help;
        }

        .kpi-insight {
            margin-top: .4rem;
            min-height: 18px;
            font-size: .78rem;
            line-height: 1.2;
            font-weight: 600;
            color: #cbd5e1;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .kpi-insight-positive { color: #5eead4; }
        .kpi-insight-negative { color: #fb7185; }

        .kpi-sparkline-wrap {
            margin-top: 10px;
            height: 32px;
            width: 100%;
            opacity: .84;
        }

        .kpi-sparkline {
            width: 100%;
            height: 32px;
            display: block;
        }

        .dashboard-metric-strip { gap: 10px; }

        .metric-strip-item {
            padding: 12px 14px;
            min-height: 88px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 6px;
        }

        .metric-strip-label,
        .dashboard-status-title,
        .health-mini-label {
            color: #94a3b8;
            font-size: .72rem;
            font-weight: 800;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .metric-strip-value,
        .dashboard-status-main,
        .health-main-value,
        .health-mini-value,
        .table-value {
            color: #f8fafc;
            font-size: 1.42rem;
            line-height: 1.05;
            font-weight: 700;
            letter-spacing: -.03em;
        }

        .metric-strip-note,
        .dashboard-status-sub,
        .health-main-note,
        .table-contract {
            color: #94a3b8;
            font-size: .82rem;
            line-height: 1.45;
            font-weight: 600;
        }

        .metric-strip-danger { color: #fb7185; }

        .health-progress-track {
            width: 100%;
            height: 9px;
            border-radius: 999px;
            background: rgba(148,163,184,.2);
            overflow: hidden;
        }

        .health-progress-fill {
            display: block;
            height: 100%;
            width: 0%;
            border-radius: 999px;
            background: linear-gradient(90deg, rgba(99,102,241,.95), rgba(139,92,246,.84));
            box-shadow: 0 0 18px rgba(99,102,241,.3);
            transition: width 240ms ease-out;
        }

        .health-mini-card {
            padding: 11px 12px;
            min-height: 76px;
        }

        .dashboard-table-host {
            overflow-y: auto;
            padding-right: 2px;
            min-height: 0;
            scrollbar-width: thin;
        }

        .dashboard-table-host::-webkit-scrollbar { width: 8px; }
        .dashboard-table-host::-webkit-scrollbar-thumb { background: rgba(71,85,105,.75); border-radius: 999px; }

        .dashboard-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .dashboard-table thead th {
            padding: 10px 12px;
            text-align: left;
            color: #94a3b8;
            font-size: .72rem;
            font-weight: 800;
            letter-spacing: .12em;
            text-transform: uppercase;
            background: rgba(255,255,255,.03);
            border-bottom: 1px solid rgba(148,163,184,.18);
            white-space: nowrap;
        }

        .dashboard-table tbody td {
            padding: 12px;
            border-top: 1px solid rgba(30,41,59,.72);
            color: #f8fafc;
            font-size: .92rem;
            vertical-align: middle;
            background: transparent;
        }

        .dashboard-table tbody tr:hover td {
            background: rgba(255,255,255,.04);
        }

        .table-action-btn {
            width: 30px;
            height: 30px;
            border-radius: 10px;
            border: 1px solid rgba(148,163,184,.34);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #cbd5e1;
            background: rgba(15,23,42,.62);
            transition: background-color 120ms ease-out, border-color 120ms ease-out, color 120ms ease-out;
        }

        .table-action-btn:hover {
            background: rgba(30,41,59,.82);
            color: #f8fafc;
            border-color: rgba(148,163,184,.5);
        }

        .table-action-btn.table-action-danger {
            color: #fda4af;
            border-color: rgba(244,63,94,.42);
            background: rgba(244,63,94,.18);
        }

        .table-action-btn.table-action-danger:hover {
            background: rgba(244,63,94,.28);
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            padding: 2px 10px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            border: 1px solid transparent;
        }

        .status-red {
            color: #fda4af;
            background: rgba(244,63,94,.2);
            border-color: rgba(244,63,94,.42);
        }

        .status-yellow {
            color: #fcd38d;
            background: rgba(245,158,11,.2);
            border-color: rgba(245,158,11,.4);
        }

        .status-green {
            color: #7ff6d4;
            background: rgba(16,185,129,.2);
            border-color: rgba(16,185,129,.42);
        }

        .chart-shell {
            position: relative;
            min-height: 320px;
        }

        .chart-container {
            background: transparent;
            border: 1px solid rgba(71,85,105,.42);
            border-radius: 18px;
            padding: .9rem;
            box-shadow: none;
        }

        .chart-empty {
            position: absolute;
            inset: .9rem;
            display: none;
            align-items: center;
            justify-content: center;
            text-align: center;
            border-radius: 14px;
            background: rgba(2,8,23,.72);
            color: #94a3b8;
            font-size: .9rem;
            line-height: 1.6;
        }

        .skeleton {
            border-radius: 8px;
            background: linear-gradient(90deg, rgba(148,163,184,.18) 25%, rgba(148,163,184,.28) 50%, rgba(148,163,184,.18) 75%);
            background-size: 240px 100%;
            animation: skeleton 1.2s ease-in-out infinite;
        }

        @keyframes skeleton {
            0% { background-position: -240px 0; }
            100% { background-position: 240px 0; }
        }

        .app-toast {
            position: fixed;
            top: 1rem;
            left: 1rem;
            right: 1rem;
            z-index: 60;
            display: flex;
            align-items: center;
            gap: 12px;
            max-width: 420px;
            border-radius: 16px;
            border: 1px solid rgba(16, 185, 129, 0.42);
            background: linear-gradient(135deg, rgba(5, 85, 70, 0.9) 0%, rgba(3, 55, 48, 0.95) 100%);
            color: #d1fae5;
            padding: 12px 14px;
            font-size: .98rem;
            font-weight: 600;
            line-height: 1.25;
            box-shadow: 0 16px 38px -22px rgba(16, 185, 129, 0.75), inset 0 1px 0 rgba(167, 243, 208, 0.16);
            backdrop-filter: blur(10px);
            opacity: 0;
            transform: translateY(-8px);
            transition: opacity 200ms ease, transform 200ms ease;
            pointer-events: none;
        }

        .app-toast.show { opacity: 1; transform: translateY(0); }

        .app-toast-error {
            border-color: rgba(239, 68, 68, 0.42);
            background: linear-gradient(135deg, rgba(127, 29, 29, 0.92) 0%, rgba(69, 10, 10, 0.95) 100%);
            color: #fee2e2;
            box-shadow: 0 16px 38px -22px rgba(239, 68, 68, 0.7), inset 0 1px 0 rgba(254, 202, 202, 0.15);
        }

        .app-toast-icon {
            width: 34px;
            height: 34px;
            border-radius: 9999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(16, 185, 129, 0.22);
            color: #a7f3d0;
            box-shadow: inset 0 0 0 1px rgba(16, 185, 129, 0.35);
            flex-shrink: 0;
        }

        .app-toast-error .app-toast-icon {
            background: rgba(239, 68, 68, 0.22);
            color: #fecaca;
            box-shadow: inset 0 0 0 1px rgba(239, 68, 68, 0.35);
        }

        .app-toast-text { word-break: break-word; }

        main { transition: none; }
        body.sidebar-collapsed .modern-sidebar { transform: translateX(-100%); }
        body.sidebar-collapsed main { margin-left: 0 !important; }

        @media (max-width: 1024px) {
            .modern-sidebar { transform: translateX(-100%); }
            .modern-sidebar.mobile-open { transform: translateX(0) !important; }
            main { margin-left: 0 !important; }
        }

        @media (max-width: 640px) {
            .kpi-value { font-size: 1.3rem; }

            .icon-btn {
                width: 36px;
                height: 36px;
                border-radius: 10px;
            }

            .icon-btn i { font-size: 1rem !important; }
            .header-user-chevron { display: none; }

            #userMenuBtn {
                max-width: min(46vw, 11rem);
                justify-content: flex-end;
            }

            .header-user-name {
                display: inline-block;
                max-width: 100%;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }
        }

        @media (min-width: 640px) {
            .app-toast {
                left: auto;
                top: 1.5rem;
                right: 1.5rem;
            }
        }

        #periodSelect:focus,
        #periodSelect:focus-visible {
            outline: none !important;
            box-shadow: none !important;
        }
    </style>
    <link rel="stylesheet" href="/styles/premium-dashboard-theme.css?v=20260303f">
    <link rel="stylesheet" href="/styles/premium-dashboard-institutional.css?v=20260303f">
</head>
<body class="dashboard-premium dashboard-financial dashboard-carteira typography-v1 primary-gradient min-h-screen">
    <header class="premium-header fixed w-full top-0 z-50">
        <div class="flex items-center justify-between px-3 py-3 sm:px-6 sm:py-4">
            <div class="flex items-center">
                <button id="sidebarToggle" class="icon-btn focus:outline-none">
                    <i class="fas fa-bars text-xl"></i>
                </button>
                <h1 class="ml-3 sm:ml-6">
                    <a href="dashboard.html" class="flex items-center" aria-label="Credix">
                        <%- include('partials/brand-wordmark', { size: 'header' }) %>
                    </a>
                </h1>
            </div>
            <div class="flex flex-1 items-center justify-end gap-1 sm:gap-4 lg:gap-6 min-w-0">
                <div class="relative min-w-0">
                    <button id="userMenuBtn" class="flex items-center gap-2 text-slate-200 hover:text-white focus:outline-none min-w-0 max-w-full overflow-hidden">
                        <span id="userName" class="header-user-name font-semibold min-w-0 truncate">OlÃ¡, <%= currentUser?.name || currentUser?.full_name || 'Administrador' %></span>
                        <i class="header-user-chevron fas fa-chevron-down text-sm"></i>
                    </button>
                    <div id="userMenuDropdown" class="absolute right-0 top-full z-50 mt-2 hidden w-56 rounded-xl border border-slate-200 bg-white p-2 shadow-xl dark:border-slate-700 dark:bg-slate-900">
                        <button type="button" data-user-menu-action="profile" class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-left text-sm font-semibold text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800">
                            <i class="fas fa-id-card text-slate-500 dark:text-slate-300"></i>
                            <span>Meu perfil</span>
                        </button>
                        <button type="button" data-user-menu-action="security" class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-left text-sm font-semibold text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800">
                            <i class="fas fa-shield-halved text-slate-500 dark:text-slate-300"></i>
                            <span>SeguranÃ§a</span>
                        </button>
                        <button type="button" data-user-menu-action="help" class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-left text-sm font-semibold text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800">
                            <i class="fas fa-circle-question text-slate-500 dark:text-slate-300"></i>
                            <span>Ajuda</span>
                        </button>
                        <div class="my-1 h-px bg-slate-200 dark:bg-slate-700"></div>
                        <button type="button" data-user-menu-action="logout" class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-left text-sm font-semibold text-red-600 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-950/40">
                            <i class="fas fa-right-from-bracket"></i>
                            <span>Sair</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="flex pt-16 sm:pt-20">
        <%- include('partials/admin-sidebar', { activePage }) %>

        <main class="flex-1 p-4 sm:p-6 lg:p-8">
            <div class="mb-6 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
                <div>
                    <h2 class="page-title text-2xl font-bold">Painel da Carteira</h2>
                    <p class="muted-on-dark mt-1 text-sm font-normal">Resumo da carteira, risco e lucro em tempo real.</p>
                </div>
                <div class="text-sm text-slate-400">
                    Atualizado: <span id="lastRefresh">--:--</span>
                </div>
            </div>
            <section class="glass-card premium-card rounded-2xl p-4 sm:p-5 mb-6">
                <div class="kpi-row-main grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                    <article class="kpi-card glass-card premium-card kpi-primary-positive">
                        <div class="flex items-start justify-between"><span class="kpi-label">Total recebido no mes</span><i class="fas fa-circle-info kpi-info" title="Entradas confirmadas no mes atual."></i></div>
                        <div class="kpi-value" id="kpiReceivedThisMonth">R$ 0,00</div>
                        <p class="kpi-insight" id="kpiReceivedThisMonthInsight">--</p>
                        <div class="kpi-sparkline-wrap"><svg id="kpiReceivedThisMonthSparkline" class="kpi-sparkline" viewBox="0 0 100 34" preserveAspectRatio="none" aria-hidden="true"></svg></div>
                    </article>
                    <article id="kpiReceivableCard" class="kpi-card glass-card premium-card">
                        <div class="flex items-start justify-between"><span class="kpi-label">A receber</span><i class="fas fa-circle-info kpi-info" title="Parcelas em aberto (futuras + atrasadas)."></i></div>
                        <div class="kpi-value" id="kpiTotalReceivableOpen">R$ 0,00</div>
                        <p class="kpi-note" id="kpiReceivableBreakdown">Futuras: R$ 0,00 • Sem inadimplencia</p>
                        <div class="kpi-sparkline-wrap"><svg id="kpiTotalReceivableOpenSparkline" class="kpi-sparkline" viewBox="0 0 100 34" preserveAspectRatio="none" aria-hidden="true"></svg></div>
                    </article>
                    <article class="kpi-card glass-card premium-card">
                        <div class="flex items-start justify-between"><span class="kpi-label">Lucro do mes</span><i class="fas fa-circle-info kpi-info" title="Resultado do mes atual."></i></div>
                        <div class="kpi-value" id="kpiProfitThisMonth">R$ 0,00</div>
                        <p class="kpi-insight" id="kpiProfitThisMonthInsight">--</p>
                        <div class="kpi-sparkline-wrap"><svg id="kpiProfitThisMonthSparkline" class="kpi-sparkline" viewBox="0 0 100 34" preserveAspectRatio="none" aria-hidden="true"></svg></div>
                    </article>
                </div>
                <div class="dashboard-metric-strip grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4">
                    <article class="metric-strip-item">
                        <p class="metric-strip-label">Total emprestado</p>
                        <p class="metric-strip-value" id="kpiTotalLoaned">R$ 0,00</p>
                        <svg id="kpiTotalLoanedSparkline" class="kpi-sparkline hidden" viewBox="0 0 100 34" preserveAspectRatio="none" aria-hidden="true"></svg>
                    </article>
                    <article class="metric-strip-item">
                        <p class="metric-strip-label">Retorno total</p>
                        <p class="metric-strip-value" id="kpiRoiRate">R$ 0,00</p>
                        <p class="metric-strip-note" id="kpiRoiRateInsight">--</p>
                        <svg id="kpiRoiRateSparkline" class="kpi-sparkline hidden" viewBox="0 0 100 34" preserveAspectRatio="none" aria-hidden="true"></svg>
                    </article>
                    <article class="metric-strip-item">
                        <p class="metric-strip-label">Taxa de inadimplencia</p>
                        <p class="metric-strip-value metric-strip-danger" id="kpiDelinquencyRate">0,00%</p>
                    </article>
                    <article class="metric-strip-item">
                        <p class="metric-strip-label">Health score</p>
                        <p class="metric-strip-value" id="kpiHealthScore">0/100</p>
                    </article>
                </div>
            </section>

            <section class="glass-card premium-card rounded-2xl p-5 mb-6">
                <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                    <h3 class="text-lg font-bold text-gray-800">Resumo do dia</h3>
                    <span class="text-xs text-gray-500">Clique para abrir Parcelas com filtro</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                    <a id="summaryDueToday" class="summary-link block p-4 sm:p-5" href="/admin/installments.html?status=pending&due=today">
                        <p class="summary-title mb-1">Vence hoje</p>
                        <p class="summary-count leading-tight" id="dueTodayCount">0</p>
                        <p class="summary-value mt-1" id="dueTodayValue">R$ 0,00</p>
                    </a>
                    <a id="summaryOverdue" class="summary-link block p-4 sm:p-5" href="/admin/installments.html?status=overdue&due=month">
                        <p class="summary-title mb-1">Em atraso (m&ecirc;s)</p>
                        <p class="summary-count leading-tight text-red-600" id="overdueCount">0</p>
                        <p class="summary-value mt-1 text-red-600" id="overdueValue">R$ 0,00</p>
