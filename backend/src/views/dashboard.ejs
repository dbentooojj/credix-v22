        if (!authUser) {
            window.location.href = '/login';
        } else {
            localStorage.setItem('isLoggedIn', 'true');
            localStorage.setItem('currentUser', JSON.stringify(authUser));
            const displayName = authUser.name || authUser.full_name || 'Administrador';
            document.getElementById('userName').textContent = `OlÃ¡, ${displayName}`;
        }

        const sidebar = document.getElementById('sidebar');
        const main = document.querySelector('main');
        const sidebarToggle = document.getElementById('sidebarToggle');
        const userMenuBtn = document.getElementById('userMenuBtn');
        const userMenuDropdown = document.getElementById('userMenuDropdown');
        const collectionModal = document.getElementById('collectionModal');
        const paymentConfirmModal = document.getElementById('paymentConfirmModal');
        const cashAdjustModal = document.getElementById('cashAdjustModal');
        const paymentConfirmInfo = document.getElementById('paymentConfirmInfo');
        const paymentDateInput = document.getElementById('paymentDateInput');
        const paymentMethodSelect = document.getElementById('paymentMethodSelect');
        const confirmPaymentBtn = document.getElementById('confirmPaymentBtn');
        const openCashAdjustModalBtn = document.getElementById('openCashAdjustModalBtn');
        const closeCashAdjustModalBtn = document.getElementById('closeCashAdjustModalBtn');
        const cancelCashAdjustBtn = document.getElementById('cancelCashAdjustBtn');
        const saveCashAdjustBtn = document.getElementById('saveCashAdjustBtn');
        const cashAdjustmentTypeInput = document.getElementById('cashAdjustmentType');
        const cashAdjustmentAmountInput = document.getElementById('cashAdjustmentAmount');
        const cashAdjustmentDateInput = document.getElementById('cashAdjustmentDate');
        const cashAdjustmentDescriptionInput = document.getElementById('cashAdjustmentDescription');
        const collectionMessageInput = document.getElementById('collectionMessage');
        const collectionPreview = document.getElementById('collectionPreview');
        const periodSelect = document.getElementById('periodSelect');
        const metricSelect = document.getElementById('metricSelect');
        const chartTypeLineBtn = document.getElementById('chartTypeLineBtn');
        const chartTypeStackedBtn = document.getElementById('chartTypeStackedBtn');
        const chartReceivedMonthValue = document.getElementById('chartReceivedMonthValue');
        const chartReceivedMoMValue = document.getElementById('chartReceivedMoMValue');
        const isMobileViewport = () => window.matchMedia('(max-width: 1024px)').matches;
        const modalScrollState = {
            previousBodyOverflow: '',
            openModalIds: new Set(),
        };

        const dashboardState = {
            period: '6m',
            metric: 'recebido',
            chart: null,
            chartView: 'line',
            lastChartPayload: null,
            upcomingById: new Map(),
            overdueById: new Map(),
            upcomingItems: [],
            overdueItems: [],
            upcomingPage: 1,
            overduePage: 1,
            panelPageSize: 5,
            selectedCollection: null,
            selectedPayment: null,
            paymentSubmitting: false,
            cashAdjustmentSubmitting: false,
        };

        const KPI_IDS = [
            'kpiCashBalance',
            'kpiTotalReceivableOpen',
            'kpiReceivedThisMonth',
            'kpiProfitThisMonth',
            'kpiRoiRate',
            'kpiTotalLoaned',
            'kpiDelinquencyRate',
        ];

        const KPI_CARD_CONFIG = [
            { key: 'cashBalance', fallbackKey: 'totalToReceive', insightId: 'kpiCashBalanceInsight', sparklineId: 'kpiCashBalanceSparkline' },
            { key: 'receivedThisMonth', insightId: 'kpiReceivedThisMonthInsight', sparklineId: 'kpiReceivedThisMonthSparkline' },
            { key: 'totalOpenReceivable', insightId: '', sparklineId: 'kpiTotalReceivableOpenSparkline' },
            { key: 'profitThisMonth', fallbackKey: 'profitTotal', insightId: 'kpiProfitThisMonthInsight', sparklineId: 'kpiProfitThisMonthSparkline' },
            { key: 'profitTotal', insightId: '', sparklineId: 'kpiRoiRateSparkline' },
            { key: 'totalLoaned', insightId: 'kpiTotalLoanedInsight', sparklineId: 'kpiTotalLoanedSparkline' },
        ];

        function lockBodyScrollForModal(modalElement) {
            if (!modalElement) return;
            const modalId = modalElement.id || '';
            if (!modalId || modalScrollState.openModalIds.has(modalId)) return;

            if (modalScrollState.openModalIds.size === 0) {
                modalScrollState.previousBodyOverflow = document.body.style.overflow || '';
                document.body.style.overflow = 'hidden';
            }

            modalScrollState.openModalIds.add(modalId);
        }

        function unlockBodyScrollForModal(modalElement) {
            if (!modalElement) return;
            const modalId = modalElement.id || '';
            if (!modalId || !modalScrollState.openModalIds.has(modalId)) return;

            modalScrollState.openModalIds.delete(modalId);

            if (modalScrollState.openModalIds.size === 0) {
                document.body.style.overflow = modalScrollState.previousBodyOverflow;
                modalScrollState.previousBodyOverflow = '';
            }
        }

        function formatCurrency(value) {
            const safe = Number.isFinite(Number(value)) ? Number(value) : 0;
            return new Intl.NumberFormat('pt-BR', {
                style: 'currency',
                currency: 'BRL',
                minimumFractionDigits: 2,
                maximumFractionDigits: 2,
            }).format(safe);
        }

        function formatPercent(value) {
            const safe = Number.isFinite(Number(value)) ? Number(value) : 0;
            return `${safe.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}%`;
        }

        function parseCurrencyInputValue(value) {
            const raw = String(value ?? '').trim();
            if (!raw) return 0;

            const sanitized = raw
                .replace(/\s+/g, '')
                .replace(/R\$/gi, '')
                .replace(/[^\d,.-]/g, '');

            const commaIndex = sanitized.lastIndexOf(',');
            const dotIndex = sanitized.lastIndexOf('.');
            let normalized = sanitized;

            if (commaIndex >= 0 && dotIndex >= 0) {
                if (commaIndex > dotIndex) {
                    normalized = sanitized.replace(/\./g, '').replace(',', '.');
                } else {
                    normalized = sanitized.replace(/,/g, '');
                }
            } else if (commaIndex >= 0) {
                normalized = sanitized.replace(/\./g, '').replace(',', '.');
            } else {
                normalized = sanitized.replace(/,/g, '');
            }

            const parsed = Number(normalized);
            return Number.isFinite(parsed) ? Math.max(parsed, 0) : 0;
        }

        function readCashAdjustmentAmountMaskState() {
            const intDigits = String(cashAdjustmentAmountInput?.dataset.amountInt || '')
                .replace(/\D/g, '')
                .replace(/^0+(?=\d)/, '');
            const decDigits = String(cashAdjustmentAmountInput?.dataset.amountDec || '')
                .replace(/\D/g, '')
                .slice(0, 2);
            const hasDecimal = String(cashAdjustmentAmountInput?.dataset.amountHasDecimal || '') === '1';

            if (intDigits || decDigits || hasDecimal) {
                return { intDigits, decDigits, hasDecimal };
            }

            const parsed = parseCurrencyInputValue(cashAdjustmentAmountInput?.value || '');
            if (parsed <= 0) return { intDigits: '', decDigits: '', hasDecimal: false };

            const [intPart, decPart] = parsed.toFixed(2).split('.');
            const trimmedDec = decPart === '00' ? '' : decPart.replace(/0+$/, '');
            return { intDigits: intPart.replace(/^0+(?=\d)/, ''), decDigits: trimmedDec, hasDecimal: trimmedDec.length > 0 };
        }

        function moveCashAdjustmentAmountCaretToEnd() {
            if (!(cashAdjustmentAmountInput instanceof HTMLInputElement)) return;
            requestAnimationFrame(() => {
                const length = cashAdjustmentAmountInput.value.length;
                cashAdjustmentAmountInput.setSelectionRange(length, length);
            });
        }

        function setCashAdjustmentAmountMaskState(state) {
            if (!(cashAdjustmentAmountInput instanceof HTMLInputElement)) return;

            const intDigits = String(state?.intDigits || '')
                .replace(/\D/g, '')
                .replace(/^0+(?=\d)/, '');
            const decDigits = String(state?.decDigits || '')
                .replace(/\D/g, '')
                .slice(0, 2);
            const hasDecimal = Boolean(state?.hasDecimal);
            const hasAnyDigit = intDigits.length > 0 || decDigits.length > 0;

            cashAdjustmentAmountInput.dataset.amountInt = intDigits;
            cashAdjustmentAmountInput.dataset.amountDec = decDigits;
            cashAdjustmentAmountInput.dataset.amountHasDecimal = hasDecimal ? '1' : '0';

            if (!hasAnyDigit && !hasDecimal) {
                cashAdjustmentAmountInput.value = '';
                cashAdjustmentAmountInput.dataset.amountValue = '0';
                return;
            }

            const integerValue = intDigits ? Number(intDigits) : 0;
            const decimalDisplay = (hasDecimal || decDigits.length > 0)
                ? decDigits.padEnd(2, '0').slice(0, 2)
                : '00';
            const numericValue = Number(`${integerValue}.${decimalDisplay}`);

            cashAdjustmentAmountInput.dataset.amountValue = Number.isFinite(numericValue)
                ? String(numericValue)
                : '0';
            cashAdjustmentAmountInput.value = `R$ ${integerValue.toLocaleString('pt-BR')},${decimalDisplay}`;
        }

        function setCashAdjustmentAmountValue(value) {
            const amount = Number(value);
            if (!Number.isFinite(amount) || amount <= 0) {
                setCashAdjustmentAmountMaskState({ intDigits: '', decDigits: '', hasDecimal: false });
                return;
            }

            const safe = Math.max(amount, 0);
            const [intPart, decPart] = safe.toFixed(2).split('.');
            const trimmedDec = decPart === '00' ? '' : decPart.replace(/0+$/, '');
            setCashAdjustmentAmountMaskState({
                intDigits: intPart.replace(/^0+(?=\d)/, ''),
                decDigits: trimmedDec,
                hasDecimal: trimmedDec.length > 0,
            });
        }

        function getCashAdjustmentAmountValue() {
            const amountFromMask = Number(cashAdjustmentAmountInput?.dataset.amountValue || 0);
            if (Number.isFinite(amountFromMask) && amountFromMask > 0) return amountFromMask;
            return parseCurrencyInputValue(cashAdjustmentAmountInput?.value || '');
        }

        function handleCashAdjustmentAmountBeforeInput(event) {
            if (!(cashAdjustmentAmountInput instanceof HTMLInputElement)) return;
            const inputType = String(event?.inputType || '');
            if (!inputType) return;

            if (inputType === 'insertFromPaste' || inputType === 'insertFromDrop') return;

            if (
                inputType !== 'insertText'
                && inputType !== 'deleteContentBackward'
                && inputType !== 'deleteContentForward'
            ) {
                return;
            }

            event.preventDefault();
            const hasFullSelection = cashAdjustmentAmountInput.selectionStart === 0
                && cashAdjustmentAmountInput.selectionEnd === cashAdjustmentAmountInput.value.length;
            let state = hasFullSelection && inputType === 'insertText'
                ? { intDigits: '', decDigits: '', hasDecimal: false }
                : readCashAdjustmentAmountMaskState();

            if (inputType === 'insertText') {
                const char = String(event.data || '');
                if (!char) return;

                if (char === ',' || char === '.') {
                    state.hasDecimal = true;
                    setCashAdjustmentAmountMaskState(state);
                    moveCashAdjustmentAmountCaretToEnd();
                    return;
                }

                if (!/^\d$/.test(char)) return;

                if (state.hasDecimal) {
                    if (state.decDigits.length < 2) {
                        state.decDigits = `${state.decDigits}${char}`.slice(0, 2);
                    }
                } else {
                    state.intDigits = `${state.intDigits}${char}`.replace(/^0+(?=\d)/, '');
                }

                setCashAdjustmentAmountMaskState(state);
                moveCashAdjustmentAmountCaretToEnd();
                return;
            }

            if (hasFullSelection) {
                setCashAdjustmentAmountValue(0);
                moveCashAdjustmentAmountCaretToEnd();
                return;
            }

            if (state.hasDecimal && state.decDigits.length > 0) {
                state.decDigits = state.decDigits.slice(0, -1);
            } else if (state.hasDecimal) {
                state.hasDecimal = false;
            } else if (state.intDigits.length > 0) {
                state.intDigits = state.intDigits.slice(0, -1);
            }

            if (!state.intDigits && !state.decDigits && !state.hasDecimal) {
                setCashAdjustmentAmountValue(0);
            } else {
                setCashAdjustmentAmountMaskState(state);
            }
            moveCashAdjustmentAmountCaretToEnd();
        }

        function handleCashAdjustmentAmountPaste(event) {
            const rawText = event.clipboardData?.getData('text') || '';
            if (!rawText) return;
            event.preventDefault();
            const parsed = parseCurrencyInputValue(rawText);
            setCashAdjustmentAmountValue(parsed);
            moveCashAdjustmentAmountCaretToEnd();
        }

        function buildKpiInsight(currentValue, previousValue) {
            const current = Number.isFinite(Number(currentValue)) ? Number(currentValue) : 0;
            const previous = Number.isFinite(Number(previousValue)) ? Number(previousValue) : 0;
            const delta = current - previous;

            if (Math.abs(previous) < 0.00001) {
                if (Math.abs(current) < 0.00001) {
                    return {
                        tone: 'neutral',
                        text: '0,00% vs mes ant.',
                    };
                }

                return {
                    tone: delta >= 0 ? 'positive' : 'negative',
                    text: 'Sem base ant.',
                };
            }

            const pct = (delta / Math.abs(previous)) * 100;
            const pctText = Math.abs(pct).toLocaleString('pt-BR', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2,
            });

            if (Math.abs(pct) < 0.005) {
                return {
                    tone: 'neutral',
                    text: '0,00% vs mes ant.',
                };
            }

            return {
                tone: pct > 0 ? 'positive' : 'negative',
                text: `${pct > 0 ? '+' : '-'}${pctText}% vs mes ant.`,
            };
        }
        function renderSparkline(svgElement, seriesValues, tone = 'neutral') {
            if (!svgElement) return;

            const values = Array.isArray(seriesValues)
                ? seriesValues
                    .map((value) => Number(value))
                    .filter((value) => Number.isFinite(value))
                : [];

            if (!values.length) {
                svgElement.innerHTML = '';
                return;
            }

            const color = tone === 'positive' ? '#10B981' : tone === 'negative' ? '#F87171' : '#9CA3AF';
            const fillColor = tone === 'positive'
                ? 'rgba(16, 185, 129, 0.15)'
                : tone === 'negative'
                    ? 'rgba(248, 113, 113, 0.15)'
                    : 'rgba(123, 134, 155, 0.13)';
            const glowColor = tone === 'positive'
                ? 'rgba(16, 185, 129, 0.35)'
                : tone === 'negative'
                    ? 'rgba(248, 113, 113, 0.35)'
                    : 'rgba(99, 102, 241, 0.35)';

            const width = 100;
            const height = 34;
            const topPad = 3;
            const bottomPad = 3;
            const usableHeight = height - topPad - bottomPad;
            const minValue = Math.min(...values);
            const maxValue = Math.max(...values);
            const range = maxValue - minValue || 1;
            const stepX = values.length > 1 ? width / (values.length - 1) : width;

            const points = values.map((value, index) => {
                const x = values.length > 1 ? index * stepX : width / 2;
                const normalized = (value - minValue) / range;
                const y = topPad + (1 - normalized) * usableHeight;
                return { x, y };
            });

            const linePath = points
                .map((point, index) => `${index === 0 ? 'M' : 'L'} ${point.x.toFixed(2)} ${point.y.toFixed(2)}`)
                .join(' ');
            const firstPoint = points[0];
            const lastPoint = points[points.length - 1];
            const areaPath = `${linePath} L ${lastPoint.x.toFixed(2)} ${(height - 1).toFixed(2)} L ${firstPoint.x.toFixed(2)} ${(height - 1).toFixed(2)} Z`;

            svgElement.innerHTML = `
                <path d="${areaPath}" fill="${fillColor}"></path>
                <path d="${linePath}" fill="none" stroke="${color}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="filter: drop-shadow(0 0 8px ${glowColor});"></path>
            `;

            const lineElement = svgElement.querySelector('path:last-child');
            if (!lineElement) return;

            const pathLength = lineElement.getTotalLength();
            lineElement.style.strokeDasharray = `${pathLength}`;
            lineElement.style.strokeDashoffset = `${pathLength}`;
            lineElement.style.transition = 'stroke-dashoffset 520ms ease-out';
            requestAnimationFrame(() => {
                lineElement.style.strokeDashoffset = '0';
            });
        }

        function renderKpiCardExtras(kpiCardsPayload) {
            const payload = (kpiCardsPayload && typeof kpiCardsPayload === 'object') ? kpiCardsPayload : {};

            KPI_CARD_CONFIG.forEach((card) => {
                const insightElement = card.insightId ? document.getElementById(card.insightId) : null;
                const sparklineElement = document.getElementById(card.sparklineId);
                const metricData = payload[card.key] || (card.fallbackKey ? payload[card.fallbackKey] : null) || {};

                const currentValue = Number(metricData.currentValue ?? 0);
                const previousValue = Number(metricData.previousValue ?? 0);
                const customInsight = metricData.insight && typeof metricData.insight === 'object'
                    ? metricData.insight
                    : null;
                const customTone = customInsight && typeof customInsight.tone === 'string'
                    ? customInsight.tone
                    : '';
                const hasCustomText = Boolean(customInsight && typeof customInsight.text === 'string' && customInsight.text.trim().length > 0);

                const insight = hasCustomText
                    ? {
                        tone: customTone === 'positive' || customTone === 'negative' ? customTone : 'neutral',
                        text: customInsight.text,
                    }
                    : buildKpiInsight(currentValue, previousValue);

                if (insightElement) {
                    insightElement.classList.remove('kpi-insight-positive', 'kpi-insight-negative');
                    if (insight.tone === 'positive') insightElement.classList.add('kpi-insight-positive');
                    if (insight.tone === 'negative') insightElement.classList.add('kpi-insight-negative');
                    insightElement.textContent = insight.text;
                }

                const rawSeries = Array.isArray(metricData.series) ? metricData.series : [];
                const seriesValues = rawSeries.map((point) => {
                    if (typeof point === 'number') return point;
                    if (point && typeof point === 'object' && 'value' in point) return Number(point.value);
                    return Number.NaN;
                });

                renderSparkline(sparklineElement, seriesValues, insight.tone);
            });
        }

