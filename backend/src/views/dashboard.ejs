        async function saveCashAdjustment() {
            if (dashboardState.cashAdjustmentSubmitting) return;
            const type = String(cashAdjustmentTypeInput?.value || 'income').toLowerCase();
            const amount = getCashAdjustmentAmountValue();
            const date = String(cashAdjustmentDateInput?.value || '').trim();
            const description = String(cashAdjustmentDescriptionInput?.value || '').trim();

            if (type !== 'income' && type !== 'expense') {
                showMessage('Tipo de ajuste invalido.', 'error');
                return;
            }

            if (!Number.isFinite(amount) || amount <= 0) {
                showMessage('Informe um valor maior que zero.', 'error');
                return;
            }

            if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) {
                showMessage('Informe uma data valida.', 'error');
                return;
            }

            setCashAdjustLoading(true);
            try {
                const response = await fetch('/api/dashboard/cash-adjustments', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({
                        type,
                        amount,
                        date,
                        description,
                    }),
                });

                const payload = await response.json().catch(() => null);
                if (!response.ok) {
                    showMessage(payload?.message || 'Falha ao salvar ajuste de caixa.', 'error');
                    return;
                }

                showMessage('Ajuste de caixa salvo.', 'success');
                closeCashAdjustModal(true);
                await loadDashboard();
            } catch (error) {
                console.error(error);
                showMessage('Erro de conexao ao salvar ajuste de caixa.', 'error');
            } finally {
                setCashAdjustLoading(false);
            }
        }

