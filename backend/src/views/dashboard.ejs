            const avgTicketElement = document.getElementById('healthAvgTicket');
            const avgInstallmentElement = document.getElementById('healthAvgInstallment');
            const openFutureElement = document.getElementById('healthInterestToReceive');
            const overdueExposureElement = document.getElementById('healthOverdueExposure');

            if (recoveryRateElement) {
                recoveryRateElement.textContent = `${Math.max(0, Math.min(recoveryRate, 100)).toLocaleString('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 1 })}%`;
