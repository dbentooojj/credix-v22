NODE_ENV=development
PORT=4000
BIND_ADDRESS=0.0.0.0
IMAGE_NAMESPACE=dbentooojj
IMAGE_TAG=latest

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=credix

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/credix?schema=public

APP_BASE_URL=http://localhost:4000

JWT_SECRET=troque_esta_chave_em_producao
JWT_EXPIRES_IN=7d
RESET_PASSWORD_SECRET=
RESET_PASSWORD_EXPIRES_IN=30m
SESSION_IDLE_MINUTES=30
COOKIE_NAME=credix_token
COOKIE_SECURE=false

WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v22.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
PIX_KEY=
PAYMENT_LINK=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Credix <usecredix@gmail.com>

EMAIL_NOTIFY_ENABLED=false
EMAIL_NOTIFY_TO=usecredix@gmail.com
EMAIL_NOTIFY_TZ=America/Sao_Paulo
EMAIL_NOTIFY_TIME=08:00
EMAIL_NOTIFY_DAYS_AHEAD=0
EMAIL_NOTIFY_RUN_ON_START=false

EMAIL_WEEKLY_BACKUP_ENABLED=false
EMAIL_WEEKLY_BACKUP_TO=
EMAIL_WEEKLY_BACKUP_TZ=America/Sao_Paulo
EMAIL_WEEKLY_BACKUP_TIME=00:00
EMAIL_WEEKLY_BACKUP_RUN_ON_START=false

ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
